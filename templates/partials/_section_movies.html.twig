<style>
/* Tighter spacing between carousel slides */
.swiper-movies .swiper-slide {
    padding-left: 0.25rem !important;
    padding-right: 0.25rem !important;
    margin-right: 0.5rem !important;
    box-sizing: border-box !important;
}
@media (min-width: 640px) {
    .swiper-movies .swiper-slide {
        padding-left: 0.375rem !important;
        padding-right: 0.375rem !important;
        margin-right: 0.625rem !important;
    }
}
@media (min-width: 1024px) {
    .swiper-movies .swiper-slide {
        margin-right: 0.625rem !important;
    }
}
</style>
<section {% if sectionId %}id="{{ sectionId }}"{% endif %}
         class="relative px-4 sm:px-6 md:px-10 lg:px-16 py-6 sm:py-8 md:py-10 bg-white/70 overflow-hidden">

    {% if withGradientTop %}
        <div class="absolute top-0 left-0 w-full h-24 sm:h-28 md:h-32 z-10 pointer-events-none"
             style="background: linear-gradient(to bottom, #FFFFFF, rgba(255,255,255,0));">
        </div>
    {% endif %}

    {% if withGradientBottom %}
        <div class="absolute bottom-0 left-0 w-full h-24 sm:h-28 md:h-80 z-10 pointer-events-none"
             style="background: linear-gradient(to top, black, #FFFFFF);">
        </div>
    {% endif %}

    <div class="relative z-20 max-w-7xl mx-auto">
        <h2 class="section-title text-2xl sm:text-3xl md:text-4xl font-bold mb-4 sm:mb-6 uppercase tracking-widest" style="color: #111827; letter-spacing: 0.12em;">
            <span class="inline-block pb-2 border-b-4" style="border-color: #722F37;">{{ title }}</span>
        </h2>

        <div class="relative -mx-2 sm:-mx-4">
            <div class="swiper swiper-movies">
                <div class="swiper-wrapper">
                {% for movie in movies %}
                    <div class="swiper-slide !flex justify-center">
                        <div class="group text-center transition duration-300 ease-in-out hover:scale-[1.03] py-2 sm:py-4 w-full" style="min-width: 0; box-sizing: border-box;">
                            <a href="{{ path('movie_show', { id: movie.id }) }}" class="group block">
                                <img src="{{ asset('pictures/films/' ~ movie.posterUrl) }}"
                                     alt="{{ movie.title }}"
                                     class="w-full max-w-[200px] sm:max-w-[220px] md:max-w-[260px] lg:max-w-[280px] xl:max-w-[300px]
                                            aspect-[2/3] object-cover rounded-xl shadow-lg mx-auto
                                            ring-2 ring-transparent group-hover:ring-amber-500/50 transition-all"
                                     style="display: block;" />
                                <p class="mt-3 sm:mt-4 text-sm sm:text-base font-medium group-hover:font-semibold transition px-1 {{ withGradientBottom ? 'text-white' : 'text-gray-900' }}">
                                    {{ movie.title }}
                                </p>
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>

                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
            </div>
        </div>
    </div>
</section>
