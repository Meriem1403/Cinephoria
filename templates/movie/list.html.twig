{% extends 'base.html.twig' %}

{% block title %}Movies — Cinephoria{% endblock %}

{% block body %}
    {% include 'partials/_header.html.twig' %}

    <main class="movies-page">
        <div class="movies-page__inner">
            {# Header: clear space below fixed nav, no giant gap #}
            <header class="movies-page__header">
                <h1 class="movies-page__title">Movies</h1>
                <p class="movies-page__subtitle">Currently showing in cinemas</p>
            </header>

            {# Genre filter: horizontal chips (modern pattern) #}
            <nav class="movies-page__filters" aria-label="Filter by genre">
                <a href="{{ path('movies') }}"
                   class="movies-page__chip {{ selectedGenre == '' ? 'movies-page__chip--active' : '' }}">
                    All
                </a>
                {% for g in genres %}
                    <a href="{{ path('movies', { genre: g.slug }) }}"
                       class="movies-page__chip {{ selectedGenre == g.slug ? 'movies-page__chip--active' : '' }}">
                        {{ g.label }}
                    </a>
                {% endfor %}
            </nav>

            {% if movies|length > 0 %}
                <ul class="movies-page__grid" role="list">
                    {% for movie in movies %}
                        <li>
                            <a href="{{ path('movie_show', { id: movie.id }) }}" class="movies-page__card">
                                <span class="movies-page__poster">
                                    <img src="{{ asset('pictures/films/' ~ movie.posterUrl) }}"
                                         alt="{{ movie.title }}"
                                         loading="lazy" />
                                </span>
                                <span class="movies-page__card-title">{{ movie.title }}</span>
                                {% if movie.rating %}
                                    <span class="movies-page__card-rating">★ {{ movie.rating|number_format(1) }}</span>
                                {% endif %}
                            </a>
                        </li>
                    {% endfor %}
                </ul>

                {% if totalPages > 1 %}
                    <nav class="movies-page__pagination" aria-label="Pagination">
                        <ul class="movies-page__pagination-list">
                            <li>
                                {% if currentPage > 1 %}
                                    <a href="{{ path('movies', selectedGenre != '' ? { genre: selectedGenre, page: currentPage - 1 } : { page: currentPage - 1 }) }}"
                                       class="movies-page__pagination-link movies-page__pagination-prev">
                                        Previous
                                    </a>
                                {% else %}
                                    <span class="movies-page__pagination-link movies-page__pagination-link--disabled">Previous</span>
                                {% endif %}
                            </li>
                            <li class="movies-page__pagination-info">
                                Page {{ currentPage }} of {{ totalPages }}
                            </li>
                            <li>
                                {% if currentPage < totalPages %}
                                    <a href="{{ path('movies', selectedGenre != '' ? { genre: selectedGenre, page: currentPage + 1 } : { page: currentPage + 1 }) }}"
                                       class="movies-page__pagination-link movies-page__pagination-next">
                                        Next
                                    </a>
                                {% else %}
                                    <span class="movies-page__pagination-link movies-page__pagination-link--disabled">Next</span>
                                {% endif %}
                            </li>
                        </ul>
                    </nav>
                {% endif %}
            {% else %}
                <div class="movies-page__empty">
                    <p>No movies in this genre.</p>
                    <a href="{{ path('movies') }}" class="movies-page__empty-link">View all movies</a>
                </div>
            {% endif %}
        </div>
    </main>

    <style>
        .movies-page {
            min-height: 100vh;
            background: #fafafa;
            padding-top: 9rem;   /* space below fixed header */
            padding-bottom: 3rem;
        }
        .movies-page__inner {
            width: 100%;
            max-width: none;
            margin: 0 auto;
            padding: 0 1.5rem;
        }
        @media (min-width: 640px) {
            .movies-page__inner { padding: 0 2rem; }
        }
        @media (min-width: 1024px) {
            .movies-page__inner { padding: 0 2.5rem; }
        }

        .movies-page__header {
            margin-bottom: 1.5rem;
        }
        .movies-page__title {
            font-size: 1.75rem;
            font-weight: 700;
            color: #111;
            margin: 0 0 0.25rem 0;
            letter-spacing: -0.02em;
        }
        .movies-page__subtitle {
            font-size: 0.9375rem;
            color: #6b7280;
            margin: 0;
        }

        /* Genre chips */
        .movies-page__filters {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 2rem;
        }
        .movies-page__chip {
            display: inline-block;
            padding: 0.5rem 1rem;
            font-size: 0.8125rem;
            font-weight: 500;
            color: #374151;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 9999px;
            text-decoration: none;
            transition: background 0.15s, border-color 0.15s, color 0.15s;
        }
        .movies-page__chip:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            color: #111;
        }
        .movies-page__chip--active {
            background: #722F37;
            border-color: #722F37;
            color: #fff;
        }
        .movies-page__chip--active:hover {
            background: #5c2630;
            border-color: #5c2630;
            color: #fff;
        }

        /* Grid: 2 → 5 → 6 → 7 columns (+3 per line on larger screens) */
        .movies-page__grid {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem 1rem;
        }
        @media (min-width: 480px) {
            .movies-page__grid { grid-template-columns: repeat(5, 1fr); gap: 1.75rem 1.25rem; }
        }
        @media (min-width: 640px) {
            .movies-page__grid { grid-template-columns: repeat(6, 1fr); gap: 2rem 1.5rem; }
        }
        @media (min-width: 1024px) {
            .movies-page__grid { grid-template-columns: repeat(7, 1fr); }
        }

        .movies-page__card {
            display: block;
            text-align: center;
            text-decoration: none;
            color: inherit;
        }
        .movies-page__card:hover .movies-page__card-title {
            color: #722F37;
        }

        /* Poster: 2:3 ratio, centered, balanced size */
        .movies-page__poster {
            display: block;
            width: 100%;
            max-width: 200px;
            margin: 0 auto;
            aspect-ratio: 2 / 3;
            border-radius: 8px;
            overflow: hidden;
            background: #e5e7eb;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            transition: box-shadow 0.2s, transform 0.2s;
        }
        .movies-page__card:hover .movies-page__poster {
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
            transform: translateY(-2px);
        }
        .movies-page__poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .movies-page__card-title {
            display: block;
            margin-top: 0.625rem;
            font-size: 1rem;
            font-weight: 600;
            color: #111;
            line-height: 1.35;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }
        .movies-page__card-rating {
            display: block;
            font-size: 0.875rem;
            color: #6b7280;
            margin-top: 0.375rem;
        }

        .movies-page__empty {
            text-align: center;
            padding: 3rem 1rem;
            color: #6b7280;
        }
        .movies-page__empty-link {
            display: inline-block;
            margin-top: 0.75rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: #722F37;
            text-decoration: none;
        }
        .movies-page__empty-link:hover {
            text-decoration: underline;
        }

        /* Pagination */
        .movies-page__pagination {
            margin-top: 2.5rem;
        }
        .movies-page__pagination-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 1rem;
        }
        .movies-page__pagination-link {
            display: inline-block;
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: #722F37;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            text-decoration: none;
            transition: background 0.15s, border-color 0.15s;
        }
        .movies-page__pagination-link:hover {
            background: #fafafa;
            border-color: #722F37;
        }
        .movies-page__pagination-link--disabled {
            color: #9ca3af;
            cursor: default;
            border-color: #e5e7eb;
        }
        .movies-page__pagination-info {
            font-size: 0.875rem;
            color: #6b7280;
        }
    </style>
{% endblock %}
